# MongoDB connection string. Use a MongoDB Atlas URI, or a local one:
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo_app?appName=<name>
# Local:  mongodb://127.0.0.1:27017/todo_app
MONGO_URI=mongodb://127.0.0.1:27017/todo_app

# Secret used to sign JWT tokens - use a long random string
JWT_SECRET=replace_this_with_a_long_random_secret_string

# JWT token expiry (e.g. 7d, 24h, 30m)
JWT_EXPIRES_IN=7d

# Port the server listens on (hosting platforms like Render set this automatically)
PORT=5000
